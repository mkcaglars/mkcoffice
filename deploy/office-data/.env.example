# Office SSO settings. Copy this file to the data folder OUTSIDE the web root
# as ".env", e.g. /home/USERNAME/office-data/.env — never into public_html.

# Must be exactly the same as OFFICE_ANAHTAR in the portal's .env.
# Generate with:  openssl rand -hex 32
PORTAL_SSO_ANAHTAR=

# Portal address: "Portaldan giriş yapın" link and where "Çıkış" returns to.
PORTAL_ADRES=https://portal.mkcaglar.com
