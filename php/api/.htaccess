# Configuration and helper files are never requested directly.
<FilesMatch "^(lib|config|sso)\.php$">
    Require all denied
</FilesMatch>

# Raise upload limits on hosts running PHP as an Apache module.
# (Hosts running PHP-FPM/CGI read .user.ini in this folder instead.)
<IfModule mod_php.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 130M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 130M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>
